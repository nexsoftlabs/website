# https://resend.com/api-keys
RESEND_API_KEY=

# Must use a verified domain in Resend (e.g. nexsoftlabs.in) or onboarding@resend.dev for testing
RESEND_FROM=NexSoft Labs Website <hello@nexsoftlabs.in>

# Inbox that receives website enquiries
CONTACT_INBOX=labs.nexsoft@gmail.com

# Comma-separated browser origins allowed to POST (production + local dev)
ALLOWED_ORIGINS=https://nexsoftlabs.in,https://www.nexsoftlabs.in,http://localhost:5180

PORT=10000

# Optional: WhatsApp alert when a form is submitted (Twilio WhatsApp API)
# https://console.twilio.com — Messaging → Try WhatsApp (sandbox) for dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox default; replace when you have an approved WhatsApp sender
TWILIO_WHATSAPP_FROM=whatsapp:+17372508034
# Your mobile in E.164, e.g. +919876543210
WHATSAPP_NOTIFY_TO=
