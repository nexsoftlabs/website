# Gmail account that sends enquiries (use an App Password, not your normal password)
# https://myaccount.google.com/apppasswords
GMAIL_USER=labs.nexsoft@gmail.com
GMAIL_APP_PASSWORD=

# Inbox that receives website enquiries (defaults to GMAIL_USER)
CONTACT_INBOX=labs.nexsoft@gmail.com

# Comma-separated browser origins allowed to POST (production + local dev)
ALLOWED_ORIGINS=https://nexsoftlabs.in,https://www.nexsoftlabs.in,http://localhost:5180

PORT=10000
