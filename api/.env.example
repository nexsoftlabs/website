# https://resend.com/api-keys
RESEND_API_KEY=

# Must use a verified domain in Resend (e.g. nexsoftlabs.in) or onboarding@resend.dev for testing
RESEND_FROM=NexSoft Labs Website <hello@nexsoftlabs.in>

# Inbox that receives website enquiries
CONTACT_INBOX=labs.nexsoft@gmail.com

# Comma-separated browser origins allowed to POST (production + local dev)
ALLOWED_ORIGINS=https://nexsoftlabs.in,https://www.nexsoftlabs.in,http://localhost:5180

PORT=10000
